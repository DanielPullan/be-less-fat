# Copy to .env and fill in. Real environment variables take precedence.
# Generate a key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# DATABASE_URL=postgresql://user:password@localhost/myapp   (unset: SQLite in instance/app.db)
# STAGING=1
# REQUIRE_MFA=1
# SECURE_COOKIES=1          (once served over HTTPS)
# BEHIND_PROXY=1            (behind Apache or another reverse proxy)
# PASSKEY_RP_ID=example.com
# PASSKEY_ORIGIN=https://example.com
